<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= recipe ? 'Edit Recipe' : 'Add Recipe' %> | Culinary Corner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar', { user: user }) %>

  <div class="container">
    <h1 class="page-title"><%= recipe ? 'Edit Recipe' : 'Add a New Recipe' %></h1>

    <div class="form-card">
      <form
        action="<%= recipe ? '/recipes/' + recipe._id + '?_method=PUT' : '/recipes' %>"
        method="POST"
      >
        <div class="form-group">
          <label>Title</label>
          <input type="text" name="title" value="<%= recipe ? recipe.title : '' %>" required>
        </div>

        <div class="form-group">
          <label>Ingredients (comma separated)</label>
          <input
            type="text"
            name="ingredients"
            placeholder="e.g. tomato, basil, mozzarella"
            value="<%= recipe ? recipe.ingredients.join(', ') : '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label>Instructions</label>
          <textarea name="instructions" required><%= recipe ? recipe.instructions : '' %></textarea>
        </div>

        <div class="form-group">
          <label>Cuisine</label>
          <input type="text" name="cuisine" value="<%= recipe ? recipe.cuisine : '' %>">
        </div>

        <div class="form-group">
          <label>Cooking Time (minutes)</label>
          <input type="number" name="cookingTime" value="<%= recipe ? recipe.cookingTime : 30 %>">
        </div>

        <div class="form-group">
          <label>Image URL (optional)</label>
          <input type="text" name="image" value="<%= recipe && recipe.image ? recipe.image : '' %>">
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%">
          <%= recipe ? 'Update Recipe' : 'Save Recipe' %>
        </button>
      </form>
    </div>
  </div>
</body>
</html>
