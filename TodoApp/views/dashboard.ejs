<!DOCTYPE html>
<html lang="en">
<head>
  <title>Todo App - Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
  <%- include('partials/header') %>

  <div class="container mt-4">

    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card text-white bg-primary">
          <div class="card-body">
            <h5 class="card-title">Total Tasks</h5>
            <h2><%= total %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-white bg-warning">
          <div class="card-body">
            <h5 class="card-title">Pending Tasks</h5>
            <h2><%= pending %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-white bg-success">
          <div class="card-body">
            <h5 class="card-title">Completed Tasks</h5>
            <h2><%= completed %></h2>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <a href="/add-task" class="btn btn-primary">+ Add New Task</a>
    </div>

    <table class="table table-bordered table-hover">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Description</th>
          <th>Priority</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% tasks.forEach(task => { %>
        <tr>
          <td><%= task.id %></td>
          <td><%= task.title %></td>
          <td><%= task.description %></td>
          <td><%= task.priority %></td>
          <td>
            <% if(task.status === 'pending') { %>
              <span class="badge bg-danger">Pending</span>
            <% } else if(task.status === 'on-going') { %>
              <span class="badge bg-warning">In Progress</span>
            <% } else { %>
              <span class="badge bg-success">Completed</span>
            <% } %>
          </td>
          <td>
            <a href="/edit-task/<%= task.id %>" class="btn btn-sm btn-warning">Edit</a>
            <a href="/delete-task/<%= task.id %>" class="btn btn-sm btn-danger">Delete</a>
            <% if(task.status === 'pending') { %>
              <a href="/update-status/<%= task.id %>/on-going" class="btn btn-sm btn-info">Start</a>
            <% } else if(task.status === 'on-going') { %>
              <a href="/update-status/<%= task.id %>/completed" class="btn btn-sm btn-success">Done</a>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

  </div>

  <%- include('partials/footer') %>
</body>
</html>